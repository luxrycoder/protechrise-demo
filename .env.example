# Origin of the waitlist-api for THIS environment. /api/* is proxied here (same-origin for the browser).
# dev.protechrise.com must point at the dev waitlist-api, never staging or prod.
API_ORIGIN=http://localhost:3000

# Public origin of THIS site. Drives canonical URLs, Open Graph, the sitemap and robots.txt.
# Optional outside production (defaults to http://localhost:3100); REQUIRED, and must be https, when
# DEV_NOINDEX=false.
SITE_URL=http://localhost:3100

# Origin of the LMS (the learning platform): the ONLY place the portal and the status page will send a learner with a
# one-time hand-off ticket. Use the same value as waitlist-api's LMS_DASHBOARD_URL (an origin only, https; plain http
# for localhost outside production). Missing or invalid: the "Open the LMS" button is not offered (fails closed).
LMS_ORIGIN=

# Non-production gate. noindex defaults to ON; set to "false" only when promoting to production.
# While ON: X-Robots-Tag noindex, robots.txt disallows everything, and titles/footer say "(dev)".
DEV_NOINDEX=true
# Set both to require HTTP basic auth on every route except /api/health.
DEV_BASIC_AUTH_USER=
DEV_BASIC_AUTH_PASS=
